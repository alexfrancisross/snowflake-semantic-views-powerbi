// Larger LIMIT/TopN over a higher-cardinality dimension.
EVALUATE
TOPN(
    200,
    SUMMARIZECOLUMNS(
        SV_CUSTOMER_ORDERS[CUSTOMER_NAME],
        SV_CUSTOMER_ORDERS[ORDER_DATE],
        "Total Revenue", SUM(SV_CUSTOMER_ORDERS[TOTAL_REVENUE])
    ),
    SV_CUSTOMER_ORDERS[ORDER_DATE], DESC
)
ORDER BY SV_CUSTOMER_ORDERS[ORDER_DATE] DESC
